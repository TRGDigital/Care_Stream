PORT=4000
NODE_ENV=development
WEB_URL=http://localhost:3000

# ── Supabase PostgreSQL ──────────────────────────────────────────────────────
# DATABASE_URL        = carestreamai_api role — RLS enforced, used by the running app
# DATABASE_DIRECT_URL = service_role (postgres) — bypasses RLS, used only for migrations
DATABASE_URL=postgresql://carestreamai_api:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
DATABASE_DIRECT_URL=postgresql://postgres:SERVICE_ROLE_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# ── Prospects sync (reads the CareAssura care_homes universe, read-only) ──────
# Used by services/prospects/sync.ts to populate the provider_leads table for the
# platform "Prospects" tab. The anon key is the CareAssura public anon key.
CAREASSURA_SUPABASE_URL=https://ktaxsqqnhvrppbxwmitc.supabase.co
CAREASSURA_SUPABASE_ANON_KEY=
# Optional: decision-maker enrichment via Companies House (free key from
# developer.company-information.service.gov.uk). Without it, enrichment still
# scrapes the provider website for a contact email but skips the named director.
COMPANIES_HOUSE_API_KEY=

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Platform owner console (/admin/*) ────────────────────────────────────────
# Super-admin login is email + password. PLATFORM_ADMIN_EMAILS is a comma-separated
# allowlist; only these emails may log in. PLATFORM_ADMIN_TOKEN is the static Bearer
# token returned on success and required by every /admin/* route — use a long random
# value (e.g. `openssl rand -hex 32`).
PLATFORM_ADMIN_EMAILS=accounts@crosswayscarehome.co.uk
PLATFORM_ADMIN_PASSWORD=
PLATFORM_ADMIN_TOKEN=

# ── Feedback links (one-click email/WhatsApp feedback) ───────────────────────
# HMAC secret used to sign one-click feedback URLs. MUST be set in production
# (otherwise a known dev fallback is used). Use a long random value.
FEEDBACK_HMAC_SECRET=

# ── Anthropic (Claude claude-sonnet-4-5) ─────────────────────────────────────
ANTHROPIC_API_KEY=

# ── OpenAI (embeddings: text-embedding-3-small) ──────────────────────────────
OPENAI_API_KEY=

# ── Pinecone ─────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=carestreamai

# ── AWS S3 (eu-west-2) ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2
S3_BUCKET=

# ── SendGrid ─────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_INBOUND_PARSE_KEY=
SENDGRID_FROM_ADDRESS=noreply@carestreamai.co.uk

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Redis (BullMQ) ───────────────────────────────────────────────────────────
REDIS_HOST=
REDIS_PORT=6379

# ── Google Sheets (regulations + CQC seeds sync) ────────────────────────────
# GOOGLE_SERVICE_ACCOUNT_JSON = full service account JSON key as a single-line string
# Obtain from: Google Cloud Console → IAM → Service Accounts → Create key (JSON)
# Share both sheets with the service account email (Editor permission)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=                  # Regulations sheet ID (from sheet URL)
GOOGLE_SHEETS_CQC_SEEDS_ID=        # CQC Seeds sheet ID (from sheet URL)

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
