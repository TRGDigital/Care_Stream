// §9 — PostgreSQL data model via Prisma
// Hosted on Supabase; RLS enforced at DB level (see supabase/rls.sql)
// Tenant isolation: tenant_id on every table, enforced at app layer + RLS safety net

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

// ─── Knowledge-gap follow-up ────────────────────────────────────────────────────

model KnowledgeGapReview {
  id               String   @id @default(uuid())
  tenant_id        String
  user_id          String
  reviewed_by      String
  reviewed_by_name String?
  note             String?
  created_at       DateTime @default(now())

  @@index([tenant_id, user_id])
  @@map("knowledge_gap_reviews")
}

// Cached "Learn & retry" remediation lesson, one per gap concept + language.
model RemediationLesson {
  id         String   @id @default(uuid())
  tenant_id  String
  ref_key    String   // '<source>:<ref>'
  lang       String
  payload    Json
  created_at DateTime @default(now())

  @@unique([ref_key, lang])
  @@map("remediation_lessons")
}

// A staff member completing a lesson and passing the fresh check question.
model RemediationAttempt {
  id         String   @id @default(uuid())
  tenant_id  String
  user_id    String
  source     String   // 'training' | 'induction'
  ref        String
  method     String   @default("learn") // 'learn' (engaged with the lesson) | 'retry'
  label      String?  // snapshot of the question text
  lang       String   @default("eng")
  created_at DateTime @default(now())

  @@index([tenant_id])
  @@index([tenant_id, user_id])
  @@map("remediation_attempts")
}

// Daily point-in-time counts of open knowledge gaps, for the trend chart.
model KnowledgeGapSnapshot {
  id              String   @id @default(uuid())
  tenant_id       String
  date            DateTime @db.Date
  open_gaps       Int      @default(0)
  open_training   Int      @default(0)
  open_induction  Int      @default(0)
  staff_with_gaps Int      @default(0)
  resolved_7d     Int      @default(0)
  created_at      DateTime @default(now())

  @@unique([tenant_id, date])
  @@index([tenant_id, date])
  @@map("knowledge_gap_snapshots")
}

// ─── Policy reading (induction) ─────────────────────────────────────────────────

model TranslationCache {
  id          String   @id @default(uuid())
  lang_code   String
  source_hash String
  translated  Json
  created_at  DateTime @default(now())

  @@unique([lang_code, source_hash])
  @@map("translation_cache")
}

model PolicyTranslation {
  id         String   @id @default(uuid())
  tenant_id  String
  policy_id  String
  lang       String
  content    String
  created_at DateTime @default(now())

  @@unique([policy_id, lang])
  @@map("policy_translations")
}

model PolicyReadSession {
  id             String   @id @default(uuid())
  tenant_id      String
  user_id        String
  policy_id      String
  step_id        String?
  enrollment_id  String?
  seconds_spent  Int      @default(0)
  max_scroll_pct Int      @default(0)
  reached_end    Boolean  @default(false)
  marked_read    Boolean  @default(false)
  lang           String   @default("eng")
  created_at     DateTime @default(now())

  @@index([tenant_id, user_id])
  @@index([tenant_id, policy_id])
  @@index([step_id])
  @@map("policy_read_sessions")
}

model SavedPolicy {
  id         String   @id @default(uuid())
  tenant_id  String
  user_id    String
  policy_id  String
  created_at DateTime @default(now())

  @@unique([user_id, policy_id])
  @@index([tenant_id, user_id])
  @@map("saved_policies")
}

// ─── Plans ────────────────────────────────────────────────────────────────────

model Plan {
  id                           String   @id @default(uuid())
  name                         String   @unique          // 'Starter' | 'Professional'
  stripe_price_id_monthly      String?
  stripe_price_id_annual       String?
  monthly_query_limit          Int
  max_policies                 Int?     // null = unlimited; Starter = 25
  max_staff_users              Int?     // null = unlimited; Starter = 10
  max_handbooks                Int?     // null = unlimited; Starter = 1
  max_manual_knowledge_entries Int?     // null = unlimited; Starter = 50
  has_advanced_analytics       Boolean  @default(false)
  has_cqc_report               Boolean  @default(false)
  has_gap_detection            Boolean  @default(false)
  monthly_ai_credit_limit      Int?     // AI generation credits/month (training, CQC, onboarding…); null = unlimited
  price_monthly_pence          Int                       // stored in pence (UK)
  is_active                    Boolean  @default(true)
  is_public                    Boolean  @default(true)    // false = internal-only (hidden from the /billing chooser)
  tenants                      Tenant[]

  @@map("plans")
}

// ─── Training licences (training-only gateway tier) ─────────────────────────────
// One row = one staff seat × one standard module, bought one-off at £25.99. The
// admin allocates a licence to a staff member (user_id) for a module (topic). A
// further module for the same staff member is a separate licence (another £25.99).
model TrainingLicense {
  id                  String    @id @default(uuid())
  tenant_id           String
  user_id             String?                              // staff member it's allocated to; null = bought but not yet allocated
  topic_id            String?                              // the standard topic/module licensed
  module_slug         String                               // snapshot (survives topic edits)
  module_name         String                               // snapshot for display + renewal emails
  price_pence         Int       @default(2599)
  currency            String    @default("gbp")
  stripe_payment_id   String?                              // Stripe Checkout session / payment-intent ref
  purchased_at        DateTime  @default(now())
  renewal_due_at      DateTime                             // purchased_at + 1 year
  renewal_reminded_at DateTime?                            // last renewal reminder sent (SendGrid)
  status              String    @default("active")         // active | expired | refunded
  created_at          DateTime  @default(now())

  @@index([tenant_id])
  @@index([tenant_id, user_id])
  @@index([renewal_due_at])
  @@map("training_licenses")
}

// ─── Tenants ──────────────────────────────────────────────────────────────────

model Tenant {
  id                  String             @id @default(uuid())
  account_number      String             @unique @default(dbgenerated("('CS-'::text || nextval('tenant_account_seq'::regclass))")) // CS-1001, CS-1002…
  name                String
  slug                String             @unique   // e.g. sunrise-care
  email_domain        String             @unique   // inbound: policies@{slug}.carestreamai.co.uk
  stripe_customer_id  String?            @unique
  stripe_subscription_id String?                              // active Stripe subscription (set via checkout/webhook)
  subscription_status String             @default("trialling") // active|trialling|past_due|cancelled
  trial_ends_at       DateTime?                                // when the Stripe trial ends (card-up-front trial)
  plan_id             String?
  tier                String             @default("full")                   // "full" = full CareStream | "training_only" = standard-training-only gateway tier
  branding_signoff    String             @default("The CareStream Team") // §4.3.4
  facility_type       String             @default("care home")              // e.g. nursing home, residential home
  response_style      String             @default("standard")               // "standard" | "concise"
  email_allowlist        String[]           @default([])                       // approved inbound sender addresses
  phone_allowlist        String[]           @default([])                       // approved WhatsApp sender numbers (+447...)
  twilio_whatsapp_number String?                                               // tenant's dedicated Twilio WA number (production)
  logo_url               String?                                               // base64 data URL of tenant logo
  email_preferences      Json               @default("{}")                     // per-type opt-in/out flags
  staff_roles            String[]           @default([])                       // configurable position list (default: PRIMARY_ROLES)
  specialist_roles       String[]           @default([])                       // configurable specialist-role list (default: SECONDARY_ROLES)
  policy_sections        String[]           @default([])                       // configurable internal-policy sections (empty → API default set)
  policy_categories      String[]           @default([])                       // tenant-added document categories (on top of the built-in 3)
  parent_tenant_id       String?                                               // null = root/standalone; set = sub-tenant
  created_at             DateTime           @default(now())
  plan                   Plan?              @relation(fields: [plan_id], references: [id])
  parent_tenant          Tenant?            @relation("TenantGroup", fields: [parent_tenant_id], references: [id])
  sub_tenants            Tenant[]           @relation("TenantGroup")
  users                  User[]
  policies               Policy[]
  queries                QueryRecord[]
  email_sessions         EmailSession[]
  whatsapp_sessions      WhatsAppSession[]
  audit_logs             AuditLog[]
  knowledge_entries      KnowledgeEntry[]
  onboarding_flows       OnboardingFlow[]
  onboarding_enrollments OnboardingEnrollment[]
  training_settings       Json               @default("{}")
  custom_languages        Json               @default("[]")                     // admin-added staff languages: [{ code, name }]
  rooms                   String[]           @default([])                       // custom room/bed names for per-room audits
  room_count              Int                @default(0)                        // number of rooms in the home (generates 1..N for the audit room picker)
  training_enrollments    TrainingEnrollment[]
  training_modules        TrainingModule[]
  cqc_staff_questions     CqcStaffQuestion[]
  cqc_staff_deliveries    CqcStaffDelivery[]
  audit_templates         AuditTemplate[]
  audit_runs              AuditRun[]

  @@map("tenants")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                     String         @id @default(uuid())
  tenant_id              String
  email                  String         @unique
  name                   String
  role                   String         @default("staff")   // admin|staff
  password_hash          String
  job_role               String?                            // position — drives onboarding/training
  specialisms            String[]       @default([])         // specialist roles (e.g. Infection Control, Night Staff)
  audit_template_ids     String[]       @default([])         // "Staff + Audits": audit templates this staff member can conduct in the hub
  phone_number           String?                            // E.164 format (+447...) — enables WhatsApp access
  is_active              Boolean        @default(true)      // false = deactivated (access revoked)
  email_verified                Boolean   @default(false)
  verification_token             String?
  verification_token_expires_at  DateTime?
  password_reset_token             String?
  password_reset_token_expires_at  DateTime?
  failed_login_attempts  Int            @default(0)         // §11.1 brute-force protection
  locked_until           DateTime?                          // lockout after 5 failed attempts
  first_login_at         DateTime?                          // set once on first successful login
  last_login_at          DateTime?                          // updated on every successful login
  last_followup_email_at DateTime?                          // debounce for the "you have follow-up" email
  shift_type             String         @default("any")     // 'any' | 'day' | 'night'
  first_language         String         @default("eng")     // ISO 639-3 — primary language for outbound comms
  second_language        String?                            // optional secondary language
  comms_always_first_language Boolean   @default(true)      // true → translate outbound comms into first_language; false → English
  allow_language_switching Boolean      @default(false)     // staff may flip a single hub set into their second_language (session-only)
  created_at             DateTime       @default(now())
  tenant                 Tenant         @relation(fields: [tenant_id], references: [id])
  queries                QueryRecord[]
  email_sessions         EmailSession[]
  policies_uploaded      Policy[]       @relation("PolicyUploader")
  audit_logs             AuditLog[]
  onboarding_enrollments OnboardingEnrollment[]
  training_enrollments TrainingEnrollment[]
  cqc_deliveries       CqcStaffDelivery[]

  @@index([tenant_id])
  @@map("users")
}

// ─── Policies ─────────────────────────────────────────────────────────────────

model Policy {
  id                   String    @id @default(uuid())
  tenant_id            String
  name                 String
  filename             String
  s3_key               String                              // full S3 object key
  document_category    String    @default("internal_policy") // §4.5: internal_policy|staff_handbook
  version              Int       @default(1)
  status               String    @default("processing")   // active|processing|archived|superseded
  content_hash         String?                              // SHA-256 of file bytes — duplicate detection
  section              String?                              // internal-policy section/taxonomy (tenant-configurable)
  tags                 Json      @default("[]")
  uploaded_by          String
  pinecone_namespace   String?                             // active Pinecone namespace for this version
  handbook_metadata    Json?                               // §4.6.6: chapter_count, chapter_map, etc.
  review_interval_days Int?                                // §10.5 policy review reminders
  last_reviewed_at     DateTime?
  superseded_by        String?                             // FK to newer Policy version (§10.5)
  created_at           DateTime  @default(now())
  updated_at           DateTime  @updatedAt
  tenant               Tenant    @relation(fields: [tenant_id], references: [id])
  uploader             User      @relation("PolicyUploader", fields: [uploaded_by], references: [id])
  newer_version        Policy?   @relation("PolicyVersionChain", fields: [superseded_by], references: [id])
  older_versions       Policy[]  @relation("PolicyVersionChain")
  onboarding_steps     OnboardingStep[]

  @@index([tenant_id, status])
  @@index([tenant_id, document_category])
  @@map("policies")
}

// ─── Queries ──────────────────────────────────────────────────────────────────

model QueryRecord {
  id                       String   @id @default(uuid())
  tenant_id                String
  user_id                  String?                            // null for email queries
  channel                  String                             // chat|email
  query_text               String
  response_text            String
  intent_type              String   @default("summary")       // summary|full_policy|follow_up
  document_category_queried String?                           // which category was searched
  policy_ids_cited         String[]
  no_match                 Boolean  @default(false)           // true = no policy found (§10.2 not-found rate)
  language_detected        String   @default("eng")           // ISO 639-3 code (§5.1)
  response_time_ms         Int
  chat_session_id          String?                            // groups multi-turn chat messages into one session
  chat_deleted_at          DateTime?                          // set when staff removes session from chat UI (records preserved)
  feedback                 String?                            // 'positive' | 'negative' — one-click staff rating
  prompt_tokens            Int?                               // §10.6 — total LLM input tokens (incl. cache) for this query
  completion_tokens        Int?                               // total LLM output tokens
  cache_read_tokens        Int?                               // prompt-cache hits (billed cheaper)
  cache_creation_tokens    Int?                               // prompt-cache writes
  model_used               String?                            // primary (most expensive) model used
  ai_cost_usd              Float?                             // real cost in USD, summed across every LLM call
  created_at               DateTime @default(now())
  tenant                   Tenant   @relation(fields: [tenant_id], references: [id])
  user                     User?    @relation(fields: [user_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, language_detected])
  @@index([tenant_id, no_match])
  @@index([tenant_id, chat_session_id])
  @@map("queries")
}

// ─── Email Sessions ───────────────────────────────────────────────────────────

// §8.2 — Threaded email conversation tracking
model EmailSession {
  id                     String   @id @default(uuid())
  tenant_id              String
  user_id                String?            // null when sender is allowlisted but not a registered user
  thread_id              String   @unique   // derived from original Message-ID header
  subject                String
  messages               Json     @default("[]") // [{role, content, timestamp, policy_ids_cited}]
  detected_category      String?            // 'internal_policy' | 'training_module' | 'cqc_report'
  awaiting_clarification Boolean  @default(false)
  last_message_at        DateTime @default(now())
  expires_at             DateTime             // 7 days from last_message_at (§8.4)
  created_at             DateTime @default(now())
  tenant                 Tenant   @relation(fields: [tenant_id], references: [id])
  user                   User?    @relation(fields: [user_id], references: [id])

  @@index([tenant_id, expires_at])
  @@map("email_sessions")
}

// ─── WhatsApp Sessions ────────────────────────────────────────────────────────

// 24-hour conversation window per sender phone number (mirrors WhatsApp's session model)
model WhatsAppSession {
  id                     String   @id @default(uuid())
  tenant_id              String
  phone_number           String                         // sender's E.164 number (+447...)
  messages               Json     @default("[]")        // [{role, content, timestamp, policy_ids_cited}]
  detected_category      String?                        // 'internal_policy' | 'training_module' | 'cqc_report' | 'audit'
  awaiting_clarification Boolean  @default(false)
  audit_run_id           String?                        // active audit run when detected_category = 'audit'
  audit_step             String?                        // 'yn' | 'outcome' | 'actions' | 'strengths' | 'improvements' | 'deadline'
  last_message_at        DateTime @default(now())
  expires_at             DateTime                       // 24h TTL — matches WhatsApp session window
  created_at             DateTime @default(now())
  tenant                 Tenant   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, phone_number])
  @@index([tenant_id, expires_at])
  @@map("whatsapp_sessions")
}

// ─── External Regulations ────────────────────────────────────────────────────

// §6.6 — Platform-level regulatory knowledge base (no tenant_id — shared read-only)
model ExternalRegulation {
  id                       String    @id @default(uuid())
  reference_key            String    @unique               // e.g. 'gdpr', 'riddor' — upsert key
  official_name            String
  also_known_as            String[]                        // synonyms for fuzzy matching
  // also_known_as_tsv is managed via trigger in supabase/rls.sql — not in Prisma schema
  summary                  String
  care_home_context        String
  care_company_interaction String
  practical_meaning        String
  source_urls              String[]
  pinecone_vector_id       String?
  last_synced_at           DateTime?
  is_active                Boolean   @default(true)

  @@map("external_regulations")
}

// Rotating refresh tokens — one row per issued refresh JWT (id = its jti). On each
// /auth/refresh the current token is rotated (rotated_at set) and a new one issued;
// reusing a rotated/unknown token is treated as theft and revokes the user's tokens.
model RefreshToken {
  id         String    @id            // jti
  user_id    String
  expires_at DateTime
  rotated_at DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("refresh_tokens")
}

// Passwordless sign-in tokens (magic link / per-staff QR). Single-use, hashed.
model LoginToken {
  id         String    @id @default(uuid())
  token_hash String    @unique
  user_id    String
  tenant_id  String
  expires_at DateTime
  used_at    DateTime?
  created_at DateTime  @default(now())

  @@index([user_id])
  @@map("login_tokens")
}

// Web-push subscriptions (one row per browser/device a staff member opted in on).
// Powers PWA push — the in-hub replacement for the WhatsApp nudge.
model PushSubscription {
  id           String    @id @default(uuid())
  tenant_id    String
  user_id      String
  endpoint     String    @unique
  p256dh       String
  auth         String
  user_agent   String?
  created_at   DateTime  @default(now())
  last_used_at DateTime?

  @@index([user_id])
  @@index([tenant_id])
  @@map("push_subscriptions")
}

// Cached, content-based coverage of each external regulation by a tenant's policies.
// Computed on demand (semantic retrieval + AI judgement), read by the Policy Gaps page.
model RegulationCoverage {
  id                   String   @id @default(uuid())
  tenant_id            String
  reference_key        String
  status               String                         // 'covered' | 'partial' | 'gap'
  confidence           Int?                           // 0-100
  evidence_policy_id   String?
  evidence_policy_name String?
  reason               String?
  analysed_at          DateTime @default(now())

  @@unique([tenant_id, reference_key])
  @@index([tenant_id])
  @@map("regulation_coverage")
}

// ─── AI Prompt Versions ───────────────────────────────────────────────────────

// Snapshot of each prompt before it is overwritten via the platform admin UI.
model AiPromptVersion {
  id        String   @id @default(uuid())
  prompt_id String
  usage     String
  label     String
  content   String
  saved_at  DateTime @default(now())

  @@index([prompt_id])
  @@map("ai_prompt_versions")
}

// ─── AI Prompts ──────────────────────────────────────────────────────────────

// Platform-level editable AI prompts. One row per usage slot.
model AiPrompt {
  id         String   @id @default(uuid())
  usage      String   @unique  // 'policy_summary' | 'policy_full' | 'knowledge_extraction' | 'training_question_generation'
  label      String
  content    String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  @@map("ai_prompts")
}

// ─── Training Seeds ──────────────────────────────────────────────────────────

// Platform-level training knowledge base used as RAG source for generating
// training module questions. No tenant_id — shared read-only across all tenants.
// One row per AI generation action that consumes a credit (training, CQC,
// onboarding question generation, …). Powers the monthly AI-credit quota.
model AiCreditLog {
  id         String   @id @default(uuid())
  tenant_id  String
  action     String?  // billable: 'training'|'cqc_questions'|'training_questions' · tracked-only: 'translation'|'audit_recs'|'remediation'
  ref_id     String?
  billable   Boolean  @default(true)  // false = tracked for cost visibility only, doesn't count toward the limit
  created_at DateTime @default(now())

  @@index([tenant_id, created_at])
  @@map("ai_credit_logs")
}

// Catalogue of training topics admins can generate AI modules from.
model TrainingTopic {
  id                 String   @id @default(uuid())
  tenant_id          String?                          // null = platform seed catalogue
  title              String
  group_key          String                           // core_mandatory|health_safety|care_clinical|conduct_governance|role_specific
  care_setting       String?                          // /who-we-serve slug; NULL = universal (shown under every setting)
  default_frequency  String   @default("annual")      // annual|biennial|triennial|once|adhoc
  requires_practical Boolean  @default(false)
  image_key          String?
  aliases            String[] @default([])
  is_active          Boolean  @default(true)
  sort_order         Int      @default(0)
  created_at         DateTime @default(now())

  @@index([tenant_id])
  @@map("training_topics")
}

model TrainingSeed {
  id                       String    @id @default(uuid())
  slug                     String    @unique               // e.g. 'safeguarding-adults'
  training_type            String                          // full name, e.g. "Safeguarding Adults"
  also_known_as            String[]                        // other search terms / aliases
  summary                  String
  care_context             String
  care_company_interaction String
  practical_meaning        String
  source_urls              String[]
  is_active                Boolean   @default(true)
  created_at               DateTime  @default(now())
  updated_at               DateTime  @default(now())

  @@map("training_seeds")
}

// ─── CQC Seeds ──────────────────────────────────────────────────────────────

// Platform-level CQC regulatory framework knowledge base.
// No tenant_id — shared read-only across all tenants.
model CqcSeed {
  id                 String   @id @default(uuid())
  slug               String   @unique
  framework_area     String                          // 'Safe' | 'Effective' | 'Caring' | 'Responsive' | 'Well-led' | custom
  also_known_as      String[]
  description        String                          // Overview of what this CQC standard area covers
  inspector_focus    String                          // What CQC inspectors look for in this area
  evidence_expected  String                          // Documentation and practices expected as evidence
  rating_indicators  String                          // What characterises Good and Outstanding ratings
  source_urls        String[]
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now())

  @@map("cqc_seeds")
}

// ─── Knowledge Base ───────────────────────────────────────────────────────────

// Per-tenant Q&A pairs extracted from policies or added manually.
// Embedded in Pinecone (knowledge namespace) and retrieved alongside policy chunks.
model KnowledgeEntry {
  id          String    @id @default(uuid())
  tenant_id   String
  question    String
  answer      String
  source_type         String    // 'policy' | 'manual'
  source_id           String?   // policy_id when source_type = 'policy'
  source_name         String    // human-readable (policy name or 'Manual entry')
  knowledge_category  String    @default("general")  // 'general' | 'business_continuity' | etc.
  vector_id           String?   // Pinecone vector ID — used for deletion
  approved    Boolean   @default(false)
  approved_at DateTime?
  approved_by String?   // email of the admin who approved
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt
  tenant      Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, source_id])
  @@index([tenant_id, approved])
  @@map("knowledge_entries")
}

// ─── Platform Custom Seeds ────────────────────────────────────────────────────

// Custom seeds added by the platform owner via the admin UI.
// Merged with PLATFORM_KNOWLEDGE_SEEDS at runtime and seeded into every tenant.
model PlatformCustomSeed {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String
  question    String
  answer      String
  source_name String
  created_at  DateTime @default(now())

  @@map("platform_custom_seeds")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

// §11.3 — Immutable append-only audit log
// INSERT only — UPDATE and DELETE blocked by RLS policy in supabase/rls.sql
model AuditLog {
  id          String   @id @default(uuid())
  tenant_id   String?                    // null for platform-level events
  user_id     String?
  event_type  String                     // policy_upload|policy_archive|policy_update|
                                         // user_invite|role_change|billing_change|query
  entity_type String                     // policy|user|tenant|query
  entity_id   String
  metadata    Json     @default("{}")    // event-specific detail
  created_at  DateTime @default(now())
  tenant      Tenant?  @relation(fields: [tenant_id], references: [id])
  user        User?    @relation(fields: [user_id], references: [id])

  @@index([tenant_id, created_at])
  @@index([tenant_id, event_type])
  @@map("audit_logs")
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

model BlogAuthor {
  id         String     @id @default(uuid())
  name       String
  title      String?
  photo_url  String?
  bio        String?
  created_at DateTime   @default(now())
  posts      BlogPost[]

  @@map("blog_authors")
}

model BlogPost {
  id                    String      @id @default(uuid())
  title                 String
  slug                  String      @unique
  excerpt               String?
  meta_title            String?
  meta_description      String?
  feature_image_url     String?
  feature_image_alt     String?
  og_image_url          String?
  content               String      @default("")
  author_id             String?
  category              String      @default("advice")
  publication_date      DateTime?
  status                String      @default("draft")  // draft|published|archived
  is_featured           Boolean     @default(false)
  read_time_minutes     Int         @default(1)
  cta_text              String?
  cta_url               String?
  special_message       String?
  special_message_color String?
  key_info_title        String?
  key_info_content      String?
  faqs                  Json?
  created_at            DateTime    @default(now())
  updated_at            DateTime    @updatedAt
  author                BlogAuthor? @relation(fields: [author_id], references: [id])

  @@index([status, publication_date])
  @@map("blog_posts")
}

// ─── Site Pages ───────────────────────────────────────────────────────────────

model SitePage {
  id             String   @id @default(uuid())
  path           String   @unique                          // e.g. /about
  title          String   @default("")
  description    String?
  og_title       String?
  og_description String?
  og_image_url   String?
  is_footer_page Boolean  @default(false)
  footer_group   String?                                   // 'Product' | 'Trust & Legal' | 'Company' | 'Get Started'
  footer_label   String?
  footer_sort    Int      @default(0)
  page_type      String   @default("marketing")            // 'marketing' | 'content'
  status         String   @default("published")
  faqs           Json     @default("[]")                    // [{ question, answer }] — currently used on the home page only
  content        String   @default("")                      // HTML body, rendered on content pages (e.g. legal pages)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("site_pages")
}

// Central alt-text store for static site images (managed in the platform console
// → Blog → Alt Tags, surfaced on the marketing pages via the SiteImage component).
model SiteImageAlt {
  id         String   @id @default(uuid())
  src        String   @unique
  alt        String   @default("")
  updated_at DateTime @updatedAt

  @@map("site_image_alts")
}

// ─── Marketing leads ──────────────────────────────────────────────────────────
// Contact + demo form submissions from the public marketing site. Platform-level
// (no tenant_id). source='agent' when submitted via a WebMCP tool by an AI agent.

model MarketingLead {
  id           String   @id @default(uuid())
  type         String                              // contact | demo
  name         String
  email        String
  organisation String?
  role         String?
  phone        String?
  homes        String?
  subject      String?
  message      String?
  source       String   @default("web")            // web | agent
  user_agent   String?
  status       String   @default("new")            // new | contacted | archived
  created_at   DateTime @default(now())

  @@index([created_at])
  @@map("marketing_leads")
}

// ─── Agent events ─────────────────────────────────────────────────────────────
// Tracks how AI agents interact with CareStream via WebMCP — one row per tool
// invocation. Platform-level, surfaced in the platform console (AI Agents tab).

model AgentEvent {
  id         String   @id @default(uuid())
  tool_name  String
  source     String   @default("webmcp")           // webmcp | mcp-server
  path       String?
  user_agent String?
  status     String   @default("ok")               // ok | error
  // Audit fields — set for confirmed, agent-initiated mutations (Phase 3).
  tenant_id  String?
  user_id    String?
  summary    String?
  mutation   Boolean  @default(false)
  confirmed  Boolean?
  created_at DateTime @default(now())

  @@index([created_at])
  @@index([tool_name])
  @@map("agent_events")
}

// One staff member flipping a single hub set into their second language. The switch
// itself is session-only; this records that it happened so admins can see where
// staff lean on their own language (a training/language gap signal). One row per
// toggle-on.
model LanguageSwitchEvent {
  id         String   @id @default(uuid())
  tenant_id  String
  user_id    String
  area       String                                // training | annual | induction | followup | cqc
  set_ref    String?                               // enrolment/flow id when the set has one
  set_name   String?                               // human label shown to admins
  lang       String                                // second-language code flipped into
  lang_name  String?                               // resolved display name at the time
  created_at DateTime @default(now())

  @@index([tenant_id, created_at])
  @@index([tenant_id, user_id])
  @@index([tenant_id, area])
  @@map("language_switch_events")
}

// Face-to-face (group/in-person) training the home runs each month. Admins log the
// session (topic, date, who delivered it), allocate who should attend, then mark who
// attended/missed. This is a separate attendance/evidence record — it does NOT change
// the digital training matrix; admins choose who to send the digital module to.
// Supports backfilling past sessions and planning future ones (calendar view).
model FaceToFaceSession {
  id                   String   @id @default(uuid())
  tenant_id            String
  module_id            String?                          // training module the session covers; null if it was later deleted
  title                String                           // snapshot of the topic name (evidence stability)
  session_date         DateTime                         // the day the session runs (date semantics; backfill = past dates)
  delivered_by_user_id String?                          // internal trainer (a staff member)
  delivered_by_name    String?                          // external / free-text trainer name
  notes                String?
  reminder_sent_at     DateTime?                        // last time the admin emailed allocated staff a reminder
  created_by           String?
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt
  attendance           FaceToFaceAttendance[]

  @@index([tenant_id, session_date])
  @@map("face_to_face_sessions")
}

// One allocated staff member for a session, with their attendance outcome and whether
// the digital catch-up module was sent to them as a result.
model FaceToFaceAttendance {
  id                 String   @id @default(uuid())
  tenant_id          String
  session_id         String
  user_id            String
  status             String   @default("allocated")    // allocated | attended | absent
  module_assigned_at DateTime?                          // set when the digital module was sent to them off the back of this session
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  session            FaceToFaceSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, user_id])
  @@index([tenant_id, user_id])
  @@map("face_to_face_attendance")
}

// ─── Onboarding ───────────────────────────────────────────────────────────────

model OnboardingFlow {
  id             String               @id @default(uuid())
  tenant_id      String?                                   // null = shared platform template; non-null = a tenant's editable copy
  name           String               // "New Starter Induction"
  description    String?
  job_roles      String[]             @default([])         // empty = applies to all roles
  flow_kind      String               @default("primary")  // primary (job role) | secondary (specialism)
  care_setting   String?                                   // nursing_home | care_home | … ; NULL = all settings
  difficulties   String[]             @default([])         // very_easy | easy | medium | hard — fed into AI question generation
  source_flow_id String?                                   // for a tenant copy: the platform template it was adopted from
  is_active      Boolean              @default(true)
  created_at     DateTime             @default(now())
  updated_at     DateTime             @updatedAt
  tenant         Tenant?              @relation(fields: [tenant_id], references: [id])
  steps          OnboardingStep[]
  enrollments    OnboardingEnrollment[]

  @@index([tenant_id, is_active])
  @@map("onboarding_flows")
}

model OnboardingStep {
  id             String   @id @default(uuid())
  flow_id        String
  order          Int
  title          String
  type           String   // read_policy | answer_question
  policy_id      String?  // resolved tenant policy (null on templates / unmapped)
  policy_section String?  // abstract policy area for templates + AI matching (e.g. "Infection control")
  question       String?  // required when type = answer_question
  options        String[] @default([])   // MCQ options for answer_question
  correct_option Int?                     // index (0-based) of the correct option
  locked         Boolean  @default(false) // "kept" — preserved when questions are re-generated
  created_at     DateTime @default(now())
  flow           OnboardingFlow @relation(fields: [flow_id], references: [id], onDelete: Cascade)
  policy         Policy?        @relation(fields: [policy_id], references: [id])
  progress       OnboardingProgress[]

  @@index([flow_id, order])
  @@map("onboarding_steps")
}

model OnboardingEnrollment {
  id           String               @id @default(uuid())
  tenant_id    String
  flow_id      String
  user_id      String
  enrolled_at  DateTime             @default(now())
  completed_at DateTime?
  due_date     DateTime?
  tenant       Tenant               @relation(fields: [tenant_id], references: [id])
  flow         OnboardingFlow       @relation(fields: [flow_id], references: [id])
  user         User                 @relation(fields: [user_id], references: [id])
  progress     OnboardingProgress[]

  @@unique([flow_id, user_id])
  @@index([tenant_id, user_id])
  @@index([tenant_id, flow_id])
  @@map("onboarding_enrollments")
}

model OnboardingProgress {
  id              String               @id @default(uuid())
  enrollment_id   String
  step_id         String
  completed_at    DateTime?
  answer_text     String?
  answer_correct  Boolean?
  enrollment      OnboardingEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
  step            OnboardingStep       @relation(fields: [step_id], references: [id])

  @@unique([enrollment_id, step_id])
  @@map("onboarding_progress")
}

// ─── Policy Seeds ─────────────────────────────────────────────────────────────

// Platform-level anonymised reference policies (sourced from a real home, stripped
// of identifying detail). Used to ground onboarding flow generation and, in Phase 2,
// to match a tenant's uploaded policies to onboarding steps.
model PolicySeed {
  id                String   @id @default(uuid())
  care_setting      String?                              // nursing_home | care_home | home_care | other
  section           String?                              // policy section (e.g. "Infection control")
  title             String
  content           String                               // anonymised policy text
  document_category String   @default("internal_policy")
  source_tenant_id  String?                              // provenance only
  source_policy_id  String?  @unique                     // provenance + dedupe on re-import
  reviewed          Boolean  @default(false)             // admin has checked the anonymisation
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  @@index([section])
  @@map("policy_seeds")
}

// ─── Training ─────────────────────────────────────────────────────────────────

model TrainingModule {
  id                  String                    @id @default(uuid())
  tenant_id           String?                                             // null = shared platform template; non-null = a tenant's editable copy
  slug                String
  name                String
  description         String
  category            String                    // 'statutory' | 'specialist'
  questions           Json                      // Array<{ id, text, options, correct }>
  is_annual           Boolean                   @default(true)
  sort_order          Int                       @default(0)
  is_active           Boolean                   @default(true)
  care_setting        String?                                             // nursing_home | care_home | … ; NULL = all settings
  questions_locked    Boolean                   @default(false)
  questions_locked_at DateTime?
  questions_version   Int                       @default(0)
  // ── AI-generated annual modules (teach-then-assess) ──
  source              String                    @default("manual")  // 'manual' | 'ai_generated'
  approved            Boolean                   @default(true)       // draft (false) until reviewed
  approved_at         DateTime?
  approved_by         String?
  learning_content    Json?                                         // { summary, key_points[], html }
  requires_practical  Boolean                   @default(false)
  frequency           String                    @default("annual")  // annual|biennial|triennial|once|adhoc
  renewal_months      Int?
  pass_mark           Int                       @default(80)
  duration_minutes    Int?                                          // estimated learning time → CPD hours (minutes/60)
  image_key           String?                                       // category/group icon key (NOT a stored image)
  illustration_key    String?                                       // S3 key of the AI-generated cover illustration
  policy_refs         Json?                                         // [{ policy_id, title, section }] — provenance / evidence base
  topic_id            String?
  group_key           String?
  // ── CPD governance (standard library) ──
  attested_by_name    String?                                       // named reviewer who attested this version at approval
  attested_by_role    String?
  attested_at         DateTime?
  standards           Json?                                         // mapped external standards [{ framework, code, label }]
  cpd_accredited      Boolean                   @default(false)     // CPD-certified → certificate shows CPD branding + hours
  independently_reviewed Boolean                @default(false)     // published via external specialist review → 'Independently reviewed' cert tag
  // ── External validation share (password-protected /validate/<token> link) ──
  share_enabled       Boolean                   @default(false)
  share_token         String?
  share_password      String?
  created_at          DateTime                  @default(now())
  tenant              Tenant?                   @relation(fields: [tenant_id], references: [id])
  enrollments         TrainingEnrollment[]
  question_versions   TrainingQuestionVersion[]

  // Partial uniques in DB: slug unique among templates; (tenant_id, slug) unique among copies.
  @@unique([tenant_id, slug])
  @@index([tenant_id])
  @@map("training_modules")
}

// Password-protected, snapshot-frozen external review/sign-off links for standard
// (platform) modules — lets an independent specialist review + attest without a login.
model ModuleReviewLink {
  id             String    @id                              // the share token
  module_id      String
  password_hash  String
  content_hash   String                                     // staleness guard vs the live module
  snapshot       Json                                       // frozen content the reviewer sees
  status         String    @default("pending")              // pending|approved|changes_requested|revoked
  created_by     String?
  created_at     DateTime  @default(now())
  expires_at     DateTime
  reviewer_name  String?
  reviewer_role  String?
  reviewer_org   String?
  reviewer_email String?
  decision       String?
  comments       String?
  decided_at     DateTime?
  item_feedback  Json?                                             // per-section/per-question sign-off [{ ref, label, status, note, resolved }]

  @@index([module_id])
  @@map("module_review_links")
}

model TrainingQuestionVersion {
  id         String         @id @default(uuid())
  module_id  String
  version    Int
  questions  Json           // full snapshot: Array<{ id, text, options, correct }>
  created_at DateTime       @default(now())
  created_by String?
  module     TrainingModule @relation(fields: [module_id], references: [id], onDelete: Cascade)

  @@unique([module_id, version])
  @@index([module_id])
  @@map("training_question_versions")
}

model TrainingEnrollment {
  id              String          @id @default(uuid())
  tenant_id       String
  user_id         String
  module_id       String
  status          String          @default("not_started") // not_started | in_progress | complete | expired
  completed_at    DateTime?
  expires_at      DateTime?
  certificate_url String?
  renewal_count   Int             @default(0)
  assigned_by     String?
  due_date        DateTime?
  practical_signed    Boolean     @default(false) // observed/practical assessment recorded (for requires_practical modules)
  practical_signed_by String?
  practical_signed_at DateTime?
  practical_note      String?
  learn_seconds       Int         @default(0)     // active time on the lesson (substantiates the CPD duration)
  eval_confidence     Int?                        // post-completion learner evaluation: 1–5 confidence applying it
  eval_usefulness     Int?                        // post-completion learner evaluation: 1–5 usefulness/relevance
  eval_comment        String?
  eval_at             DateTime?
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  tenant          Tenant          @relation(fields: [tenant_id], references: [id])
  user            User            @relation(fields: [user_id], references: [id])
  module          TrainingModule  @relation(fields: [module_id], references: [id])
  answers         TrainingAnswer[]

  @@unique([tenant_id, user_id, module_id, renewal_count])
  @@index([tenant_id, user_id])
  @@index([tenant_id, expires_at])
  @@map("training_enrollments")
}

model TrainingAnswer {
  id            String             @id @default(uuid())
  enrollment_id String
  question_id   String
  question_text String?            // snapshot of question text at time of answering
  answer_text   String             // selected option letter: 'A', 'B', 'C', or 'D'
  is_correct    Boolean            @default(false)
  answered_at   DateTime           @default(now())
  enrollment    TrainingEnrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@unique([enrollment_id, question_id])
  @@index([enrollment_id])
  @@map("training_answers")
}

// ─── Training Delivery ────────────────────────────────────────────────────────

model TrainingDeliveryRule {
  id                 String   @id @default(uuid())
  tenant_id          String
  module_id          String?
  name               String
  rule_type          String   @default("scheduled")  // 'scheduled'
  is_active          Boolean  @default(true)
  target_audience    String   @default("all")         // 'all' | 'day_shift' | 'night_shift' | 'specific'
  target_user_ids    String[] @default([])
  days_of_week       Int[]    @default([])             // 0=Sun … 6=Sat
  send_time          String?                           // 'HH:MM' Europe/London
  questions_per_send Int      @default(3)
  frequency_cap_day  Int?
  frequency_cap_week Int?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  created_by         String?
  send_logs          TrainingSendLog[]

  @@index([tenant_id])
  @@map("training_delivery_rules")
}

model TrainingSendLog {
  id           String    @id @default(uuid())
  tenant_id    String
  rule_id      String?
  module_id    String?
  user_id      String
  question_ids String[]  @default([])
  trigger_type String    // 'scheduled' | 'manual' | 'return_to_work' | 'post_incident' | 'quizme' | 'spaced_repetition'
  triggered_by String?
  context      String?
  sent_at      DateTime  @default(now())
  rule         TrainingDeliveryRule? @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([tenant_id, sent_at])
  @@index([user_id])
  @@map("training_send_log")
}

// ─── CQC Staff Questions ──────────────────────────────────────────────────────

model CqcStaffQuestion {
  id           String             @id @default(uuid())
  tenant_id    String
  domain       String             // 'safe' | 'effective' | 'caring' | 'responsive' | 'well_led'
  question     String
  model_answer String
  is_active    Boolean            @default(true)
  is_seed      Boolean            @default(false)  // true = pre-loaded default question
  created_at   DateTime           @default(now())
  updated_at   DateTime           @updatedAt
  tenant       Tenant             @relation(fields: [tenant_id], references: [id])
  deliveries   CqcStaffDelivery[]

  @@index([tenant_id, domain])
  @@index([tenant_id, is_active])
  @@map("cqc_staff_questions")
}

model CqcStaffDelivery {
  id           String           @id @default(uuid())
  tenant_id    String
  question_id  String
  user_id      String
  rephrased_q  String           // AI-rephrased version sent to staff
  channel      String           @default("whatsapp")  // 'whatsapp' | 'email' | 'portal'
  answer_text  String?
  score        Int?             // 0–100 AI evaluation score (latest attempt)
  first_score  Int?             // score on the very first attempt — kept so we can show improvement after retry
  feedback     String?          // AI constructive feedback
  status       String           @default("pending")  // 'pending' | 'answered' | 'evaluated'
  attempts     Int              @default(1)           // bumped each time staff re-attempt after a low score
  sent_at      DateTime         @default(now())
  answered_at  DateTime?
  evaluated_at DateTime?
  tenant       Tenant           @relation(fields: [tenant_id], references: [id])
  question     CqcStaffQuestion @relation(fields: [question_id], references: [id])
  user         User             @relation(fields: [user_id], references: [id])

  @@unique([tenant_id, user_id, question_id])
  @@index([tenant_id, user_id])
  @@index([tenant_id, status])
  @@index([user_id, status])
  @@map("cqc_staff_deliveries")
}

// ─── Audits ───────────────────────────────────────────────────────────────────

// Platform-level or tenant-custom audit template (e.g. "Health & Safety Monthly")
model AuditTemplate {
  id          String         @id @default(uuid())
  tenant_id   String?                              // null = platform default (shared read-only)
  name        String
  description String?
  is_active   Boolean        @default(true)
  is_seed     Boolean        @default(false)
  frequency   String         @default("monthly")  // daily | weekly | monthly | quarterly | periodic
  created_at  DateTime       @default(now())
  updated_at  DateTime       @updatedAt
  tenant      Tenant?        @relation(fields: [tenant_id], references: [id])
  sections    AuditSection[]
  runs        AuditRun[]

  @@index([tenant_id])
  @@map("audit_templates")
}

model AuditSection {
  id            String          @id @default(uuid())
  template_id   String
  title         String
  section_order Int
  template      AuditTemplate   @relation(fields: [template_id], references: [id], onDelete: Cascade)
  questions     AuditQuestion[]

  @@index([template_id])
  @@map("audit_sections")
}

model AuditQuestion {
  id             String        @id @default(uuid())
  section_id     String
  question_text  String
  question_order Int
  question_type  String        @default("yes_no")   // yes_no | yes_no_na | findings | free_text
  is_active      Boolean       @default(true)
  section        AuditSection  @relation(fields: [section_id], references: [id], onDelete: Cascade)
  answers        AuditAnswer[]

  @@index([section_id])
  @@map("audit_questions")
}

model AuditRun {
  id                 String        @id @default(uuid())
  tenant_id          String
  template_id        String
  audit_month        DateTime                           // first day of the audit month
  auditor_name       String?
  auditor_role       String?
  shift              String?                                // 'day' | 'night' — for shift-based daily templates
  room_number        String?                                // for room-by-room templates
  status             String        @default("in_progress")  // in_progress | completed
  ai_recommendations String?
  strengths          String?
  improvements       String?
  actions_deadline   String?
  completed_at       DateTime?
  created_at         DateTime      @default(now())
  updated_at         DateTime      @updatedAt
  tenant             Tenant        @relation(fields: [tenant_id], references: [id])
  template           AuditTemplate @relation(fields: [template_id], references: [id])
  answers            AuditAnswer[]

  @@index([tenant_id, status])
  @@index([tenant_id, audit_month])
  @@map("audit_runs")
}

model AuditAnswer {
  id           String        @id @default(uuid())
  run_id       String
  question_id  String
  answer_yn    Boolean?
  answer_na    Boolean       @default(false)
  outcome_text String?
  actions_text String?
  answered_at  DateTime      @default(now())
  run          AuditRun      @relation(fields: [run_id], references: [id], onDelete: Cascade)
  question     AuditQuestion @relation(fields: [question_id], references: [id])

  @@unique([run_id, question_id])
  @@index([run_id])
  @@map("audit_answers")
}

// ─── Landing page system (B2B PPC) ────────────────────────────────────────────
// Data-driven conversion landing pages served on demos.carestreamai.com.
// Guarded by the API layer (public read of active pages; management via the
// platform-admin token), not Supabase RLS.
model LandingPage {
  id                             String   @id @default(uuid())
  product_slug                   String                              // 'carestream'
  campaign_slug                  String
  is_active                      Boolean  @default(false)
  noindex                        Boolean  @default(true)
  content                        Json                                // LP content (validated app-side)
  variant_group                  String?
  variant_label                  String?
  traffic_allocation             Int      @default(100)
  conversion_type                String   @default("demo_booking")   // demo_booking|contact|download|trial_signup
  conversion_value_pennies       Int?
  additional_notification_emails String[] @default([])
  google_ads_conversion_id       String?
  google_ads_conversion_label    String?
  meta_pixel_id                  String?
  meta_event_name                String?
  linkedin_partner_id            String?
  linkedin_conversion_id         String?
  ga4_measurement_id             String?
  meta_title                     String?
  meta_description               String?
  og_image_url                   String?
  created_at                     DateTime @default(now())
  updated_at                     DateTime @updatedAt
  submissions                    LpSubmission[]
  events                         LpEvent[]

  @@unique([product_slug, campaign_slug])
  @@index([variant_group])
  @@map("landing_pages")
}

model LpSubmission {
  id                   String      @id @default(uuid())
  landing_page_id      String
  data                 Json
  utm_source           String?
  utm_medium           String?
  utm_campaign         String?
  utm_term             String?
  utm_content          String?
  gclid                String?
  fbclid               String?
  referrer             String?
  page_url             String?
  user_agent           String?
  ip_address           String?
  viewport             String?
  device_type          String?
  time_on_page_seconds Int?
  scroll_depth_pct     Int?
  variant_group        String?
  variant_label        String?
  status               String      @default("new")  // new|contacted|qualified|disqualified|converted|lost
  qualified_at         DateTime?
  converted_at         DateTime?
  created_at           DateTime    @default(now())
  landing_page         LandingPage @relation(fields: [landing_page_id], references: [id])

  @@index([landing_page_id, created_at])
  @@index([variant_group, variant_label])
  @@map("lp_submissions")
}

model LpEvent {
  id              String      @id @default(uuid())
  landing_page_id String
  session_id      String
  event_type      String      // page_view|form_start|field_focus|field_blur|field_error|form_submit|phone_click|cta_click|scroll_*
  field_name      String?
  metadata        Json?
  created_at      DateTime    @default(now())
  landing_page    LandingPage @relation(fields: [landing_page_id], references: [id])

  @@index([landing_page_id, session_id])
  @@index([event_type, created_at])
  @@map("lp_events")
}

// ─── RalfyIndex auto-indexing ──────────────────────────────────────────────────
// Pushes new public pages (blog posts, marketing/SEO pages) to ralfyindex.com for
// automatic search-engine indexing. Tables created via manual_ralfyindex.sql.

model RalfyIndexConfig {
  id             String   @id @default("singleton")
  api_key        String?
  enabled        Boolean  @default(true)
  instant_index  Boolean  @default(false)
  project_prefix String   @default("CareStream")
  updated_at     DateTime @default(now()) @db.Timestamptz(6)

  @@map("ralfyindex_config")
}

model RalfyIndexSubmission {
  id           String   @id @default(uuid())
  url          String
  source       String   @default("blog") // blog|page
  blog_post_id String?
  project_name String?
  status       String   @default("submitted") // submitted|failed
  credits_used Int?
  error        String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, created_at])
  @@index([url])
  @@map("ralfyindex_submissions")
}
