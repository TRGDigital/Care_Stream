{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": { "maxDuration": 60, "memory": 1769 }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/src/app.ts" }
  ],
  "crons": [
    { "path": "/health", "schedule": "*/2 * * * *" },
    { "path": "/cron/knowledge-gaps", "schedule": "0 7 * * *" }
  ]
}
