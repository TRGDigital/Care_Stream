{
  "version": 2,
  "builds": [
    {
      "src": "src/app.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 300,
        "memory": 1769,
        "includeFiles": [
          "../../node_modules/pdfkit/js/standard-fonts/**",
          "node_modules/pdfkit/js/standard-fonts/**",
          "../../node_modules/ffmpeg-static/ffmpeg",
          "node_modules/ffmpeg-static/ffmpeg",
          "../../node_modules/ffprobe-static/bin/linux/x64/ffprobe",
          "node_modules/ffprobe-static/bin/linux/x64/ffprobe"
        ],
        "excludeFiles": [
          "**/ffprobe-static/bin/darwin/**",
          "**/ffprobe-static/bin/win32/**",
          "**/ffprobe-static/bin/linux/ia32/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/src/app.ts"
    }
  ],
  "regions": [
    "dub1"
  ]
}
